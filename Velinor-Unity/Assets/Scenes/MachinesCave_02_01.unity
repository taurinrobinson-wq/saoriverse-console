  m_Script: {fileID: 11500000, guid: 7039b053f7e591b488c15995cdbefd5c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectorInteractionController
  currentStage: 0
  projectorDisabled: 0
  projectorCollider: {fileID: 0}
  codexController: {fileID: 886167976}
  projectorDisplay: {fileID: 1511258043}
  mindLogImage_Stage01: DefaultMindLogImage
  mindLogText_Stage01: What is this machine? The image on it looks really distorted...maybe
    its broken
  mindLogText_Stage02: The image looks less distorted, but I still don't know what
    it is.
  mindLogText_Stage03: It definitely looks more like a person but there's like two
    faces...What is this supposed to be.
  mindLogImage_Stage04: DefaultMindLogImage
  mindLogText_Stage04_Initial: The image looks fully resolved now...It's even smiling
    like something has been resolved. But why am I seeing all of this? Oh looks like
    the machine is working now.
  mindLogImage_Velinor: VelinorImage
  mindLogText_Final: I... I don't know what just happened... the projector showed
    a woman I've never seen... she looked... terrified, like she was trying to get
    out, and then... she was just gone... This place... it feels like it was built
    for something I don't understand... everything feels... wrong. At least the cave
    door opened and I can finally leave. Maybe I should ask around and see if anyone
    knows anything.
  glyphSprite: {fileID: 21300000, guid: d5f5fab172a3c374cb122c19d27cc058, type: 3}
  velinorSequenceDelay: 2
  triglyphScreenDisplayDuration: 3
  triglyphScreenPanel: {fileID: 234720360}
  doorOpenSound: {fileID: 8300000, guid: 1febefda8f032844eac75179837475b6, type: 3}
  audioSource: {fileID: 0}
  sceneTransitionCollider: {fileID: 1096872670}

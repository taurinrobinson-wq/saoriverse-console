{
  "scene_id": "elenya_act1_seg3_shrine_domain",
  "npc": "Elenya",
  "npc_full_name": "High Seer Elenya",
  "beats": [
    {
      "id": 1,
      "type": "npc_turn",
      "active_speaker": "Elenya",
      "display_name": "Elenya",
      "portrait_expression": "grounded_teaching",
      "setting_description": "The Mountain Shrine: Where Presence Lives",
      "prompt": "The shrine is not about ritual or doctrine. It's about bearing witness. People come here carrying weight they can't name. I listen. I hold space. And somehow, the weight becomes bearable.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Trust",
          "text": "You're describing what you do when Malrik is near...you bear witness. You hold space for his confusion.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "I do. And it tears me apart, because I recognize exactly what he's confused about. It's the same ache I performed a ritual to forget.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Empathy",
              "delta": 0.15
            },
            {
              "stat": "elenya_influence",
              "delta": 0.15
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        },
        {
          "tone": "O",
          "label": "Observation",
          "text": "",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "trust",
              "delta": -0.005
            },
            {
              "stat": "observation",
              "delta": 0.02
            },
            {
              "stat": "narrative",
              "delta": 0.005
            },
            {
              "stat": "empathy",
              "delta": -0.005
            }
          ],
          "remnants_effects": [
            {
              "target": "Elenya",
              "stat": "authority",
              "delta": 0.01
            },
            {
              "target": "Elenya",
              "stat": "memory",
              "delta": 0.005
            },
            {
              "target": "Elenya",
              "stat": "nuance",
              "delta": 0.01
            },
            {
              "target": "Elenya",
              "stat": "need",
              "delta": -0.01
            }
          ],
          "system_triggers": []
        },
        {
          "tone": "N",
          "label": "NarrativePresence",
          "text": "Your students don't know they're learning from someone who chose to forget the person she loved most. That's the deepest teaching.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "They learn presence through my presence with them. And I teach release because I know the cost of holding on. Every word I speak about letting go comes from standing in his marketplace, calling him nothing but his name.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Empathy",
              "delta": 0.2
            },
            {
              "stat": "Observation",
              "delta": 0.1
            }
          ],

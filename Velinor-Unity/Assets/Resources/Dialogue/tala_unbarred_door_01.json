        },
        {
          "tone": "N",
          "label": "Narrative",
          "text": "I could use the work. What's the pay?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Bits, if you stick around. For now? Meal and maybe some salvage for yourself. I don't have much to spare, but I don't ask people to work hungry.",

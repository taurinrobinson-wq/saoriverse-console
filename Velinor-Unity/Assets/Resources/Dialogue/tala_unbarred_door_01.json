      "portrait_expression": "curious",
      "setting_description": "Tala's Market Cookstall - afternoon activity, smell of cooking",
      "prompt": "Hey! You look like someone who doesn't mind getting their hands dirty. I need help salvaging some ingredients from the marketplace. Most of it's damaged or spoiled, but if you know what to look for... well, some things can be made safe.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Trust",
          "text": "I'd be happy to help. I need to understand how things work here anyway.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Good. You've got that look about you—like you're willing to learn instead of just take. That's rare.",
          "audio_clip_on_response": "",

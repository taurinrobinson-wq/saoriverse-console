      "prompt_source": {
        "type": "previous_choice_response",
        "beat_id": 1,
        "choice_field": "npc_response"
      },
      "prompt": "Come on then. I'll show you what I mean. Most people's instinct is wrong about food—they see damage and think it's all ruined. But damage isn't always death.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Learn",
          "text": "Show me. I want to understand.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "There's a reason I asked if you were willing to learn. This isn't something you can do halfway.",

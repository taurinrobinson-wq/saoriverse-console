        {
          "tone": "O",
          "label": "Ask",
          "text": "What's the distinction? What makes food safe versus dangerous after damage?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Context and time. A bruised apple can still be eaten. Grain with moisture and time becomes something else entirely. You learn the difference or you poison people.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "determined",
          "tone_effects": [

        {
          "tone": "O",
          "label": "Observation",
          "text": "I noticed you throw a lot of food away. What criteria are you using to decide what's salvageable?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Sharp eye. Most people don't ask. It's about texture, smell, color—learned it the hard way when you're trying to feed people without getting them sick.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "determined",
          "tone_effects": [

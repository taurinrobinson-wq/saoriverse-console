{
  "scene_id": "elenya_act1_seg0_intro",
  "npc": "Elenya",
  "npc_full_name": "High Seer Elenya",
  "beats": [
    {
      "id": 1,
      "type": "npc_turn",
      "active_speaker": "Elenya",
      "display_name": "Elenya",
      "portrait_expression": "neutral",
      "setting_description": "The Seer's Sanctuary",
      "prompt": "Welcome. I've been expecting you...though I didn't know when. Sit. Let's see what brought you here.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Trust",
          "text": "",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "trust",
              "delta": 0.02
            },
            {
              "stat": "observation",
              "delta": -0.01
            },
            {
              "stat": "narrative",
              "delta": -0.005
            },
            {
              "stat": "empathy",
              "delta": 0.01
            }
          ],
          "remnants_effects": [
            {
              "target": "Elenya",
              "stat": "trust",
              "delta": 0.01
            },
            {
              "target": "Elenya",
              "stat": "authority",
              "delta": 0.01
            },
            {
              "target": "Elenya",
              "stat": "skepticism",
              "delta": -0.01
            },
            {
              "target": "Elenya",
              "stat": "resolve",
              "delta": 0.005
            }
          ],
          "system_triggers": []
        },
        {
          "tone": "O",
          "label": "Observation",
          "text": "People say you understand things others don't. What do you see that they miss?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "I see the patterns beneath chaos. I see what people long for before they know they're longing. Come closer...let me see what you carry with you.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Observation",
              "delta": 0.05
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        },
        {
          "tone": "N",
          "label": "NarrativePresence",
          "text": "I think our meeting isn't random. I think it means something.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Nothing is random. Everything is a thread in an ongoing story. You're here because the story needs you here. That's enough.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Empathy",
              "delta": 0.1
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        },
        {
          "tone": "E",
          "label": "Empathy",
          "text": "I feel like something changed in the world. Something fundamental. Can you help me understand?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "You feel it in your bones. That's good. Too many people think only with their minds. Yes, something shifted. We're all finding our way through it.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Empathy",
              "delta": 0.1
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        }
      ],
      "next_beat_id": 2,
      "system_triggers": []
    },

{
  "scene_id": "elenya_act2_seg2_mystic_philosophy",
  "npc": "Elenya",
  "npc_full_name": "High Seer Elenya",
  "beats": [
    {
      "id": 1,
      "type": "npc_turn",
      "active_speaker": "Elenya",
      "display_name": "Elenya",
      "portrait_expression": "wise_sorrowing",
      "setting_description": "The Way of Presence and Release",
      "prompt": "The Skeptics believe the world can be fixed through evidence and structure. But I've learned...through my own breaking...that some wounds need presence, not analysis. Meaning lives in the space between order and chaos.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Trust",
          "text": "",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "trust",
              "delta": 0.02
            },
            {
              "stat": "observation",
              "delta": -0.01
            },
            {
              "stat": "narrative",
              "delta": -0.005
            },
            {
              "stat": "empathy",
              "delta": 0.01
            }
          ],
          "remnants_effects": [
            {
              "target": "Elenya",
              "stat": "trust",
              "delta": 0.01
            },
            {
              "target": "Elenya",
              "stat": "authority",
              "delta": 0.01
            },
            {
              "target": "Elenya",
              "stat": "skepticism",
              "delta": -0.01
            },
            {
              "target": "Elenya",
              "stat": "resolve",
              "delta": 0.005
            }
          ],
          "system_triggers": []
        },
        {
          "tone": "O",
          "label": "Observation",
          "text": "But he's teaching order because of the same wound. You're both trying to honor what you can't quite name.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Yes. His preservation is my release. His structure is my dissolution. And when I see him working in his Archive, cataloguing fragments... I see myself too. We're both grieving.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Observation",
              "delta": 0.15
            },
            {
              "stat": "Empathy",
              "delta": 0.1
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        },
        {
          "tone": "N",
          "label": "NarrativePresence",
          "text": "Your philosophies aren't contradictions. They're two languages for the same truth about what it means to survive.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Then perhaps the building debate isn't about which approach is right. It's about learning to speak both languages. To honor both preservation and release.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Empathy",
              "delta": 0.2
            },
            {
              "stat": "elenya_influence",
              "delta": 0.2
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        },
        {

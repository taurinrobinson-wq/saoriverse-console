              "target": "Tala",
              "stat": "empathy",
              "delta": 0.02
            }
          ],
          "system_triggers": [],
          "npc_portrait_expression": "curious"
        },
        {
          "tone": "O",
          "label": "Question",
          "text": "What would you want to hear from her? Not an apology necessarily—what would matter?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "I don't know. Recognition, maybe? That what happened to us was real, and we both survived it differently.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "cautious",
          "tone_effects": [

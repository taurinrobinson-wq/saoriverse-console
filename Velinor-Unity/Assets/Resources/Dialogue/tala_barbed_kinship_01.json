              "target": "Tala",
              "stat": "nuance",
              "delta": 0.02
            }
          ],
          "system_triggers": [],
          "npc_portrait_expression": "cautious"
        },
        {
          "tone": "N",
          "label": "Suggest",
          "text": "Maybe it's better to leave old things alone.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "That's what I thought. But she reached out. And I... I can't ignore that.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "determined",
          "tone_effects": [
            {
              "stat": "trust",

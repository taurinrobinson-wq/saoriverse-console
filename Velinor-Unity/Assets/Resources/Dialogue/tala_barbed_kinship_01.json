      "display_name": "Tala",
      "portrait_expression": "resolved",
      "setting_description": "Tala's Cookstall - moment of understanding",
      "prompt": "Tala realizes something in that moment. Her mother didn't fix anything. Didn't erase the pain or change the past. But she acknowledged what Tala had built. Not as redemption. As recognition.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Accept",
          "text": "I know you did the best you could. I know now that the best you could do... was what you could do.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Yes. That's... yes.",

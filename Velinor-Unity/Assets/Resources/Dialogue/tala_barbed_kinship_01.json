          "text": "Continue",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "The food you made... it was good. And this—the stall, your work. It's impressive, Tala. I suppose... thank you.",
          "audio_clip_on_response": "",

        "choice_field": "npc_response"
      },
      "prompt": "",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Share",
          "text": "I didn't accept it well at first. But I realized—my parents loved me even in their mistakes. That doesn't disappear just because they're gone.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "My mother thinks all she did was hurt me. My father... I barely knew him before the collapse. And I've spent so long being angry at them both for not being what I needed.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "curious",
          "tone_effects": [
            {
              "stat": "trust",
              "delta": 0.03
            },
            {
              "stat": "observation",
              "delta": 0
            },
            {
              "stat": "narrative",
              "delta": 0
            },
            {
              "stat": "empathy",
              "delta": 0.02
            }
          ],
          "remnants_effects": [

  "beats": [
    {
      "id": 1,
      "type": "npc_turn",
      "active_speaker": "Tala",
      "display_name": "Tala",
      "portrait_expression": "sad",
      "setting_description": "Tala's Cookstall After Closing - quiet, dimly lit",
      "prompt": "My mother is coming to the marketplace. After nearly a decade, she's finally... I don't know what I'm supposed to do with that.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Listen",
          "text": "You sound worried. Tell me what happened between you two.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "We both survived something neither of us should have survived. And somehow, that made us hate each other for it.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "sad",
          "tone_effects": [
            {
              "stat": "trust",
              "delta": 0.03

              "target": "Tala",
              "stat": "trust",
              "delta": 0.03
            },
            {
              "target": "Tala",
              "stat": "empathy",
              "delta": 0.02
            }
          ],
          "system_triggers": [],
          "npc_portrait_expression": "sad"
        },
        {
          "tone": "O",
          "label": "Question",
          "text": "How long has it been since you've spoken?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "A decade. Since I left the caves. We haven't had a real conversation since before the collapse. She remembers me as someone I'm not anymore.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "skeptical",
          "tone_effects": [
            {
              "stat": "trust",
              "delta": 0.01
            },
            {
              "stat": "observation",
              "delta": 0.02
            },
            {

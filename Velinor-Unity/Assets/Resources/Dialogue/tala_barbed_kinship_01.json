            }
          ],
          "system_triggers": [],
          "npc_portrait_expression": "determined"
        },
        {
          "tone": "E",
          "label": "Offer",
          "text": "Then talk to her. Not to fix things. Just to... exist together.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "That's the problem. I don't know if I can exist with her without fighting. But you've lost both your parents, haven't you? How do you... how did you accept that?",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "sad",
          "tone_effects": [

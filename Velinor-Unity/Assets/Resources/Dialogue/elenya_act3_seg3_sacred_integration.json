  "beats": [
    {
      "id": 1,
      "type": "npc_turn",
      "active_speaker": "Elenya",
      "display_name": "Elenya",
      "portrait_expression": "visionary_tender",
      "setting_description": "The Building as Covenant",
      "prompt": "The building doesn't belong to the Skeptics or the Mystics. It belongs to both. I want to place offeringsâ€”flame, cloth, meaningâ€”alongside his precise catalogues. Because both honor what was lost.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Trust",
          "text": "You're not asking him to change his approach. You're asking him to expand it. To see that structure and meaning, preservation and presence, can coexist.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Yes. And I'm asking it by living it. By standing in the building with him. By being present while he preserves. By honoring what we lost together.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Empathy",
              "delta": 0.2
            },
            {
              "stat": "elenya_influence",
              "delta": 0.25
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        },
        {
          "tone": "O",
          "label": "Observation",
          "text": "He fears that ritual will compromise the integrity of the Archive. But what if the ritual IS the integrity?",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "That's what I'm trying to show him. That sacred and preserved aren't opposites. They're different ways of honoring the same wound.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Observation",
              "delta": 0.15
            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        },

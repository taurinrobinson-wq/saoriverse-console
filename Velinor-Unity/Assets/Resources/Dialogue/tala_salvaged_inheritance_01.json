            }
          ],
          "remnants_effects": [],
          "system_triggers": []
        }
      ],
      "next_beat_id": 0,
      "system_triggers": [
        {
          "type": "glyph_effect",
          "data": ["legacy_resonance", "3"]
        },
        {
          "type": "diary_append",
          "data": ["The storm ruined most of the celebration's food. But in that moment, Tala stopped seeing her parents' teachings as a burden and recognized them as a gift—the resourcefulness to make do, the knowledge to salvage, the grace to keep going. She's not defined by what happened to her. She's defined by what she chose to do with it."]
        },

          ],
          "system_triggers": []
        },
        {
          "tone": "N",
          "label": "NarrativePresence",
          "text": "You've become who you needed to become. Through the forgetting and back through the remembering.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "We both have. He needed to grieve without knowing what he was grieving. I needed to survive by letting go. And now we're hereâ€”changed, wiser, ready for what comes next.",

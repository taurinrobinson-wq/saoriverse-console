    {
      "id": 1,
      "type": "npc_turn",
      "active_speaker": "Elenya",
      "display_name": "Elenya",
      "portrait_expression": "integrated_teaching",
      "setting_description": "The Wisdom of What Was Lost",
      "prompt": "I taught my students compassion without attachment. Presence without possession. But I was teaching from a wound, not wisdom. Now I understand: sometimes the most loving act is the one that lets go. And sometimes grace arrives as a second meeting.",
      "audio_clip": "",
      "shared_beat": "",
      "tone_choices": [
        {
          "tone": "T",
          "label": "Trust",
          "text": "Your students can now learn from bothâ€”the teaching and the wound that taught it.",
          "audio_clip_on_choice": "",
          "result_text": "",
          "show_result_in_notification": false,
          "npc_response": "Yes. I can finally teach what I know instead of what I wish I'd lived. And that's its own kind of wholeness.",
          "audio_clip_on_response": "",
          "portrait_expression_on_response": "",
          "tone_effects": [
            {
              "stat": "Empathy",
              "delta": 0.2
            }

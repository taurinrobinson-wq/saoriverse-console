            "choices": [
                {
                    "tone_str": "Trust",
                    "playerLine": "I wanted to see if you had any work available. Your stall looks organized.",
                    "npcResponse": "NIMA: \"Work? That's not something you trade for with compliments. But you're not wrong. I run a tight operation.\"",

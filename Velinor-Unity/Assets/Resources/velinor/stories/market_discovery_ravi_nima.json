                    "playerLine": "I don't mean to make you uncomfortable. It's been a long trip, any place to rest around here?",
                    "tone_effects": {
                        "entries": [
                            {
                                "key": "Observation",
                                "value": 0.02
                            }
                        ]
                    }
                },
                {
                    "text": "(N) I've heard the market is a place to find work. I'm not here to cause trouble.",
                    "target": "market_discovery_beat_2_npc_interject",
                    "tone_str": "NarrativePresence",
                    "playerLine": "I've heard the market is a place to find work. I'm not here to cause trouble.",
                    "tone_effects": {
                        "entries": [
                            {
                                "key": "NarrativePresence",
                                "value": 0.02
                            }
                        ]
                    }
                },
                {
                    "text": "(E) I'm not here to bother anyone. I've had a long road… that's all.",
                    "target": "market_discovery_beat_2_npc_interject",
                    "tone_str": "Empathy",
                    "playerLine": "I'm not here to bother anyone. I've had a long road… that's all.",
                    "tone_effects": {

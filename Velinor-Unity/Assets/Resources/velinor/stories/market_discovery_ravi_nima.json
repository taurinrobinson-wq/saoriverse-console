            "text": "What do you want anyway? We don't trust outsiders.",
            "required_flags": [],
            "npc_responses": {
                "Trust": "Work is scarce for people who actually belong here. Intentions don't fill empty bellies.",
                "Observation": "Comfort isn't something we trade in anymore. The corners are dry, if you can sleep with one eye open.",
                "NarrativePresence": "Trouble usually follows the people who claim they aren't carrying any. Keep your hands where they can be seen.",
                "Empathy": "Everyone out here has a long road behind them. It doesn't make the ground any softer."
            },
            "choices": [
                {
                    "text": "(T) I'm trying to find work. I'm new here.",
                    "target": "market_discovery_beat_2_npc_interject",
                    "tone_str": "Trust",
                    "playerLine": "I'm trying to find work. I'm new here.",
                    "tone_effects": {

        {
            "pid": "saori_react_to_choice",
            "name": "Saori's Device",
            "conversationId": "saori_encounter_01",
            "text": "You should take this. It will help you understand what you are about to encounter.",
            "required_flags": [],
            "choices": [
                {
                    "text": "(T) I trust you. I'll take it.",
                    "target": "saori_device_given",
                    "shared_beat": "Good. Keep it close.",
                    "system_trigger": "give_device",
                    "data_hook": "received_saori_device=true",
                    "tone_effects": {
                        "entries": [
                            {
                                "key": "Trust",
                                "value": 0.03
                            }
                        ]
                    },
                    "tone_str": "Trust",
                    "playerLine": "I trust you. I'll take it."
                },
                {
                    "text": "(O) What is this thing exactly? How does it work?",
                    "target": "saori_device_given",
                    "shared_beat": "You will understand when the moment comes. For now, trust the device.",
                    "system_trigger": "give_device",
                    "data_hook": "received_saori_device=true|saori_questioned=true",
                    "tone_effects": {
                        "entries": [
                            {
                                "key": "Observation",
                                "value": 0.03
                            }
                        ]
                    },
                    "tone_str": "Observation",
                    "playerLine": "What is this thing exactly? How does it work?"
                },
                {
                    "text": "(N) This feels significant. More significant than it appears.",
                    "target": "saori_device_given",
                    "shared_beat": "Yes. More significant than most would ever comprehend.",
                    "system_trigger": "give_device",
                    "data_hook": "received_saori_device=true|saori_connection_noted=true",
                    "tone_effects": {
                        "entries": [
                            {
                                "key": "NarrativePresence",
                                "value": 0.03
                            }
                        ]
                    },
                    "tone_str": "NarrativePresence",
                    "playerLine": "This feels significant. More significant than it appears."
                },
                {
                    "text": "(E) Thank you. I don't know why, but I feel like you truly care about my survival.",
                    "target": "saori_device_given",
                    "shared_beat": "I do what I must.",
                    "system_trigger": "give_device",
                    "data_hook": "received_saori_device=true|saori_emotional_connection=true",
                    "tone_effects": {
                        "entries": [
                            {
                                "key": "Empathy",
                                "value": 0.04
                            }
                        ]
                    },
                    "npc_resonance": {
                        "entries": [
                            {
